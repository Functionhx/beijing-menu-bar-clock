// Per-branch identity. Each variant branch (control-panel, liquid, ultra, nano) edits
// only this file to get its own app name, bundle id, update feed, release tags and version.
// Note: "//" starts a comment in xcconfig, so URLs are written as https:/$()/...

BMC_BRANCH = control-panel
BMC_PRODUCT_NAME = Beijing Clock
BMC_BUNDLE_ID = com.chen.dualtime
BMC_DISPLAY_NAME = 北京时间
BMC_FEED_URL = https:/$()/raw.githubusercontent.com/Functionhx/beijing-menu-bar-clock/$(BMC_BRANCH)/appcast.xml

// Sparkle EdDSA public key. The private key lives only in the release Mac's login keychain
// (account "beijing-menu-bar-clock", created with Vendor/Sparkle/bin/generate_keys).
BMC_SPARKLE_PUBLIC_KEY = nSGTfka6F10skNU4QYUPAKJLB4mjz73M52q9qKptPzA=

// Bump both for every release: MARKETING_VERSION is shown to users,
// CURRENT_PROJECT_VERSION must strictly increase (Sparkle compares it).
MARKETING_VERSION = 1.4.0
CURRENT_PROJECT_VERSION = 5
